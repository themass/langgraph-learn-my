# ============================================================================
# ProAgent 配置模板
# ============================================================================
# 复制此文件为 .env 并填入实际的配置值
# 命令: cp .env.example .env
# ============================================================================

# ============================================================================
# LLM 配置 (Kimi / Moonshot AI)
# ============================================================================
# Moonshot AI API Key (必填)
# 获取地址: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Moonshot AI Base URL (可选，默认值已设置)
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 默认 LLM 模型 (可选)
# 可选值: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
DEFAULT_LLM_MODEL=moonshot-v1-32k

# LLM 默认温度 (可选，范围 0-1)
DEFAULT_LLM_TEMPERATURE=0.3

# ============================================================================
# 或者使用 OpenAI (二选一)
# ============================================================================
# OpenAI API Key (如果使用 OpenAI 而不是 Moonshot)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# 工具配置
# ============================================================================
# Tavily API Key (用于搜索工具，可选)
# 获取地址: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================================
# 数据库配置 (MySQL 持久化，可选)
# ============================================================================
# 方式 1: 使用完整的 DATABASE_URL (推荐)
# DATABASE_URL=mysql+aiomysql://username:password@host:port/database

# 方式 2: 使用独立配置项
DB_HOST=localhost
DB_PORT=3306
DB_USER=agent_user
DB_PASSWORD=agent_password
DB_NAME=proagent
DB_DRIVER=mysql+aiomysql

# ============================================================================
# 其他配置
# ============================================================================
# 项目环境 (development / production)
ENVIRONMENT=development

# 是否启用调试模式
DEBUG=true
